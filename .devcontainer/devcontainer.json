{
  "name": "ARM32 Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "runArgs": ["--privileged"],
  "postCreateCommand": "bash .devcontainer/setup-arm32.sh",
  "remoteUser": "vscode"
}
